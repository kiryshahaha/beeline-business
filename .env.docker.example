# ==============================================================================
# Docker Compose Environment Configuration
# Скопируйте этот файл в .env перед первым запуском:
# cp .env.docker.example .env
# ==============================================================================

# --- База данных (PostgreSQL) ---
POSTGRES_DB=beeline
POSTGRES_USER=beeline
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# --- Основной бэкенд (FastAPI) ---
BACKEND_PORT=8000
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
NOTIFICATION_DISPATCHER_ENABLED=true
NOTIFICATION_POLL_INTERVAL_SECONDS=1.0

# Автоматическое наполнение демо-данными при первом старте контейнера (true / false)
AUTO_SEED=false

# Разрешенные CORS источники (через запятую)
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:80,http://127.0.0.1:80,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Публичные адреса для ссылок календаря (.ics). Пусто: адрес API берётся из запроса,
# ссылка на карточку заявки в событии не добавляется.
PUBLIC_API_URL=
FRONTEND_URL=http://localhost

# --- Nginx (Единая точка входа / Reverse Proxy) ---
NGINX_PORT=80

# --- Микросервис планировщика (Planner / Solver) ---
PLANNER_PORT=8001

# --- Ассистент (чат) и Ollama ---
# Чат-помощник в бэкенде (POST /api/v1/assistant/chat); без true ручка отвечает 503.
ASSISTANT_ENABLED=false
ASSISTANT_PORT=8002
# Стандартная модель из реестра Ollama. Дообученная: положите GGUF в
# assistant/model/model.gguf и укажите qwen3.5-beeline:2b (см. assistant/model/README.md).
ASSISTANT_MODEL=qwen3.5:2b
OLLAMA_PORT=11434
# Сколько модель остаётся в памяти после последнего запроса
OLLAMA_KEEP_ALIVE=24h
# Потоки генерации на CPU. Пусто — решает Ollama. Docker Desktop на Mac M1 Pro: 8
LLM_NUM_THREAD=

# --- Фронтенд (Next.js) ---
FRONTEND_PORT=3000
# По умолчанию пусто: в Docker запросы идут через единую точку входа (Nginx) по относительному пути /api/v1.
# Задайте явный адрес (например http://localhost:8000), если фронтенд запускается отдельно без Nginx.
NEXT_PUBLIC_API_URL=

# Planning is enabled explicitly after configuring work requirements and secrets.
PLANNING_ENABLED=false
PLANNER_SERVICE_TOKEN=
PLANNER_BASE_URL=http://planner:8001
PLANNING_SOLVE_TIME_LIMIT_SECONDS=5
PLANNING_PREVIEW_TTL_SECONDS=300
PLANNING_TOTAL_TIMEOUT_SECONDS=60
GEOAPIFY_API_KEY=
GEOAPIFY_TIMEOUT_SECONDS=10
