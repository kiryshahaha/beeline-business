meta {
  name: Выбрать целевую бригаду
  type: http
  seq: 3
}

put {
  url: {{base_url}}/api/v1/tickets/{{execution_ticket_id}}/brigade
  body: json
  auth: bearer
}

auth:bearer {
  token: {{observer_access_token}}
}

body:json {
  {"brigade_id": {{execution_brigade_id}}}
}

assert {
  res.status: eq 200
  res.body.brigade_id: eq {{execution_brigade_id}}
}
