meta {
  name: Отправить заявку в работу
  type: http
  seq: 4
}

post {
  url: {{base_url}}/api/v1/tickets/{{execution_ticket_id}}/dispatch
  body: json
  auth: bearer
}

auth:bearer {
  token: {{observer_access_token}}
}

headers {
  Idempotency-Key: execution-dispatch
}

body:json {
  {
    "expected_revision": 3,
    "occurred_at": "{{execution_occurred_at}}",
    "payload": {}
  }
}

script:pre-request {
  bru.setVar("execution_occurred_at", new Date().toISOString());
}

assert {
  res.status: eq 200
}

tests {
  test("Заявка получила статус dispatched", function () {
    expect(res.getBody().state).to.equal("dispatched");
    expect(res.getBody().revision).to.equal(4);
  });
}
