meta {
  name: Подтвердить новое окно визита
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/v1/tickets/{{execution_ticket_id}}/window-change
  body: json
  auth: bearer
}

auth:bearer {
  token: {{observer_access_token}}
}

headers {
  Idempotency-Key: execution-window-change
}

body:json {
  {
    "expected_revision": 2,
    "occurred_at": "{{execution_occurred_at}}",
    "reason": "Клиент подтвердил новое окно",
    "new_window_start": "{{execution_new_window_start}}",
    "new_window_end": "{{execution_new_window_end}}",
    "payload": {}
  }
}

script:pre-request {
  bru.setVar("execution_occurred_at", "2030-01-17T07:30:00.000Z");
  bru.setVar("execution_new_window_start", "2030-01-17T08:00:00.000Z");
  bru.setVar("execution_new_window_end", "2030-01-17T12:00:00.000Z");
}

assert {
  res.status: eq 200
}

tests {
  test("Сохранено новое окно и увеличена ревизия", function () {
    const ticket = res.getBody();
    expect(ticket.revision).to.equal(3);
    expect(new Date(ticket.visit_window_start).getTime()).to.equal(
      new Date(bru.getVar("execution_new_window_start")).getTime()
    );
    expect(new Date(ticket.visit_window_end).getTime()).to.equal(
      new Date(bru.getVar("execution_new_window_end")).getTime()
    );
  });
}
