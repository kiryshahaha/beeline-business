meta {
  name: Зафиксировать недоступность до конца смены
  type: http
  seq: 15
}

post {
  url: {{base_url}}/api/v1/workers/{{execution_unavailable_worker_id}}/unavailable
  body: json
  auth: bearer
}

auth:bearer {
  token: {{observer_access_token}}
}

headers {
  Idempotency-Key: execution-worker-unavailable
}

body:json {
  {
    "expected_revision": 1,
    "occurred_at": "{{execution_unavailable_at}}",
    "service_area_id": {{service_area_id}},
    "route_date": "{{execution_route_date}}",
    "worker_id": {{execution_unavailable_worker_id}},
    "reason": "Инженер завершил смену раньше",
    "expected_available_at": "{{execution_available_at}}",
    "payload": {}
  }
}

script:pre-request {
  bru.setVar("execution_unavailable_at", "2030-01-17T12:00:00.000Z");
  bru.setVar("execution_available_at", "2030-01-17T13:00:00.000Z");
}

assert {
  res.status: eq 200
}

tests {
  test("Инженер отмечен недоступным", function () {
    expect(res.getBody().available).to.equal(false);
    expect(res.getBody().reason).to.equal("Инженер завершил смену раньше");
  });
}
