meta {
  name: Инженер не меняет статус линии
  type: http
  seq: 4
}

put {
  url: {{base_url}}/api/v1/workers/{{worker_id}}/line-status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{worker_access_token}}
}

body:json {
  {"is_on_line":true}
}

assert {
  res.status: eq 403
}

tests {
  test("Доступ закрыт для инженера", function () {
    expect(res.getBody().detail).to.equal("Недостаточно прав для выполнения операции");
  });
}
