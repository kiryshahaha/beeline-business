meta {
  name: Выбрать бригаду перед проверкой статуса линии
  type: http
  seq: 0
}

put {
  url: {{base_url}}/api/v1/tickets/{{created_ticket_id}}/brigade
  body: json
  auth: bearer
}

auth:bearer {
  token: {{observer_access_token}}
}

body:json {
  {"brigade_id": {{workflow_brigade_id}}}
}

assert {
  res.status: eq 200
  res.body.brigade_id: eq {{workflow_brigade_id}}
}
