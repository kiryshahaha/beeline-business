meta {
  name: Текущая заявка остаётся у инженера
  type: http
  seq: 2
}

get {
  url: {{base_url}}/api/v1/tickets/{{ticket_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{observer_access_token}}
}

assert {
  res.status: eq 200
}

tests {
  test("Заявка в работе не освобождена", function () {
    const body = res.getBody();
    expect(body.status).to.equal("in_progress");
    expect(body.assigned_worker_id).to.equal(Number(bru.getVar("worker_id")));
  });
}
