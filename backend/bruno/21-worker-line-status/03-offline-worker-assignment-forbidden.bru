meta {
  name: Нельзя назначить снятого с линии инженера
  type: http
  seq: 3
}

put {
  url: {{base_url}}/api/v1/tickets/{{created_ticket_id}}/assignees
  body: json
  auth: bearer
}

auth:bearer {
  token: {{observer_access_token}}
}

body:json {
  {"worker_id": {{worker_id}}}
}

assert {
  res.status: eq 422
}

tests {
  test("API объясняет запрет назначения", function () {
    const detail = res.getBody().detail;
    expect(detail.code).to.equal("manual_assignment_rejected");
    expect(detail.violations.map((violation) => violation.code)).to.include("worker_offline");
  });
}
