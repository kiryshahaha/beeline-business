meta {
  name: Календарь скачивается без JWT
  type: http
  seq: 2
}

get {
  url: {{base_url}}/api/v1/schedule/calendar.ics?token={{calendar_token}}
  body: none
  auth: none
}

params:query {
  token: {{calendar_token}}
}

assert {
  res.status: eq 200
}

tests {
  test("Ответ — документ iCalendar", function () {
    expect(res.getHeader("content-type")).to.include("text/calendar");
    expect(res.getHeader("cache-control")).to.equal("private, no-store");
    const body = res.getBody();
    expect(body).to.be.a("string");
    expect(body).to.contain("BEGIN:VCALENDAR");
    expect(body).to.contain("END:VCALENDAR");
  });
}
