meta {
  type: collection
}

script:pre-request {
  // Локальные значения работают и при выборе No Environment.
  const localDefaults = {
    base_url: "http://127.0.0.1:8000",
    city_id: 1,
    district_id: 1,
    primorsky_district_id: 2,
    krasnogvardeysky_district_id: 3,
    ticket_id: 1,
    location_id: 1,
    office_id: 1,
    appliance_id: 1,
    missing_ticket_id: 2147483647,
    observer_username: "demo_observer",
    observer_password: "ObserverSecret123!",
    worker_username: "demo_worker_1",
    worker_password: "WorkerSecret123!",
    worker_two_username: "demo_worker_2",
    worker_two_password: "WorkerSecret123!"
  };

  Object.entries(localDefaults).forEach(function ([name, fallback]) {
    const configured = bru.getEnvVar(name);
    // Обновляем перед каждым запросом, чтобы переключение окружения применялось сразу.
    bru.setVar(name, configured === undefined || configured === null || configured === ""
      ? fallback
      : configured);
  });
}

docs {
  Коллекция по умолчанию обращается к http://127.0.0.1:8000, даже без окружения.
  Непустые значения выбранного окружения переопределяют локальные значения.
  ID по умолчанию рассчитаны на новую базу после seed_demo.py; в другой базе измените их в Local.
  Настройки передаются в runtime-переменные, поэтому проверки используют bru.getVar().
}
