meta {
  name: История исполнителя
  type: http
  seq: 0
}

get {
  url: {{base_url}}/api/v1/notifications?limit=20&offset=0
  body: none
  auth: bearer
}

auth:bearer {
  token: {{worker_access_token}}
}

assert {
  res.status: eq 200
}

tests {
  test("Исполнитель получил новое назначение", function () {
    const events = res.getBody();
    expect(events.some(function (event) {
      return event.kind === "ticket_assigned"
        && event.ticket_id === Number(bru.getVar("ticket_id"));
    })).to.equal(true);
  });
}
