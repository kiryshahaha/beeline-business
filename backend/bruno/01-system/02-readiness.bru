meta {
  name: Проверить готовность backend и зависимостей
  type: http
  seq: 2
}

get {
  url: {{base_url}}/ready
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("База, миграции и planner готовы", function () {
    expect(res.getBody()).to.deep.equal({
      status: "ready",
      checks: { database: "ok", migrations: "ok", planner: "ok" }
    });
  });
}

docs {
  Проверяет PostgreSQL, текущую ревизию миграций Alembic и GET /health planner.
  Проверка не вызывает Geoapify и не требует JWT.
}
