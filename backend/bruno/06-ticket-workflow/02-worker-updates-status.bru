meta {
  name: Исполнитель не может менять статус
  type: http
  seq: 2
}

patch {
  url: {{base_url}}/api/v1/tickets/{{ticket_id}}/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{worker_access_token}}
}

body:json {
  {"status":"in_progress"}
}

assert {
  res.status: eq 403
}

tests {
  test("Смена статуса доступна только наблюдателю", function () {
    expect(res.getBody().detail).to.be.a("string");
  });
}
