meta {
  name: Прочитать участок заявки
  type: http
  seq: 2
}

get {
  url: {{base_url}}/api/v1/tickets/{{ticket_id}}
  auth: bearer
}

auth:bearer {
  token: {{observer_access_token}}
}

assert {
  res.status: eq 200
}

script:post-response {
  bru.setVar("workflow_service_area_id", res.getBody().service_area_id);
}
