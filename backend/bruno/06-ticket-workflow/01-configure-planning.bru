meta {
  name: Настроить требования планирования вида работ
  type: http
  seq: 1
}

put {
  url: {{base_url}}/api/v1/work-types/1/planning-rules
  body: json
  auth: bearer
}

auth:bearer {
  token: {{observer_access_token}}
}

body:json {
  {
    "service_duration_source": "ticket_estimate",
    "required_skill_ids": [2],
    "required_appliances": []
  }
}

assert {
  res.status: eq 200
  res.body.configured: eq true
}

docs {
  Вид работ 1 новой демобазы — «Подключение клиентов Базовая». Проверка оставляет навык 2
  «Работы на подключение и дозаказы», снимает обязательный роутер (заявки папки 22-execution
  создаются без резерва) и берёт длительность из оценки заявки. Эта настройка базы
  остаётся в силе при импорте пакетов.
}
