meta {
  name: Мой день исполнителя
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/v1/me/day
  body: none
  auth: bearer
}

auth:bearer {
  token: {{worker_access_token}}
}

assert {
  res.status: eq 200
  res.body.worker.id: isDefined
  res.body.shift.is_working_day: isDefined
  res.body.tickets: isDefined
  res.body.removed_tickets: isDefined
}
