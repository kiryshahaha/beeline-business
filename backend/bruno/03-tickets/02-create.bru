meta {
  name: Создать заявку — добавляет запись в БД
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/tickets
  body: json
  auth: bearer
}

auth:bearer {
  token: {{observer_access_token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "location_id": {{location_id}},
    "title": "Проверка Wi-Fi из Bruno",
    "description": "Учебная заявка, созданная вручную из коллекции Bruno.",
    "work_type_id": 1,
    "status": "planned",
    "visit_window_start": "{{demo_window_start}}",
    "visit_window_end": "{{demo_window_end}}",
    "planned_start_at": null,
    "planned_end_at": null,
    "estimated_duration_minutes": 60,
    "actual_duration_minutes": null
  }
}

script:pre-request {
  // Каждый запуск получает новое окно: от текущего времени +1 час до +5 часов.
  const now = Date.now();
  bru.setVar("demo_window_start", new Date(now + 60 * 60 * 1000).toISOString());
  bru.setVar("demo_window_end", new Date(now + 5 * 60 * 60 * 1000).toISOString());
  // Не используем ID прошлого успешного POST, если текущая попытка завершится ошибкой.
  bru.setVar("created_ticket_id", "");
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("created_ticket_id", res.getBody().id);
  }
}

assert {
  res.status: eq 201
}

tests {
  test("Создана заявка на выбранное место", function () {
    const ticket = res.getBody();
    expect(ticket.id).to.be.a("number").and.above(0);
    expect(ticket.location_id).to.equal(Number(bru.getVar("location_id")));
    expect(ticket.location.id).to.equal(ticket.location_id);
    expect(ticket.title).to.equal("Проверка Wi-Fi из Bruno");
    expect(ticket.status).to.equal("planned");
    expect(res.getHeader("location")).to.equal("/api/v1/tickets/" + ticket.id);
  });
}

docs {
  Каждое выполнение создаёт новую заявку. Укажите существующее Local.location_id.
  Окно посещения задаёт Pre Request: сейчас +1 час — сейчас +5 часов (UTC).
  После успешного ответа ID сохраняется в переменную created_ticket_id для следующего GET.
  Это создание заявки, а не запуск seed_demo.py: повторы не удаляются автоматически.
}
