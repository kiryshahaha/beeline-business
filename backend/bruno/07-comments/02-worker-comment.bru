meta {
  name: Комментарий исполнителя
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/tickets/{{ticket_id}}/comments
  body: json
  auth: bearer
}

auth:bearer {
  token: {{worker_access_token}}
}

body:json {
  {"text":"Для замены нужен новый разъём."}
}

assert {
  res.status: eq 201
}

tests {
  test("Автор имеет роль worker", function () {
    expect(res.getBody().author.role).to.equal("worker");
  });
}
