meta {
  name: Наблюдатель строит маршрут на мотоцикле
  type: http
  seq: 8
}

post {
  url: {{base_url}}/api/v1/routes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{observer_access_token}}
}

body:json {
  {
    "origin": {"latitude": 55.700654, "longitude": 37.759714},
    "destination": {"latitude": 55.702267, "longitude": 37.773852},
    "mode": "motorcycle"
  }
}

tests {
  test("Наблюдатель получает маршрут на мотоцикле", function () {
    const status = res.getStatus();
    const body = res.getBody();

    expect(status).to.equal(200);
    expect(body.distance_meters).to.be.a("number").and.greaterThan(0);
    expect(body.duration_seconds).to.be.a("number").and.greaterThan(0);
    expect(body.geometry.type).to.equal("MultiLineString");
    expect(body.geometry.coordinates).to.be.an("array").and.not.empty;
  });
}
