meta {
  name: Исполнитель не строит произвольный маршрут
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/routes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{worker_access_token}}
}

body:json {
  {
    "origin": {"latitude": 55.700654, "longitude": 37.759714},
    "destination": {"latitude": 55.702267, "longitude": 37.773852}
  }
}

assert {
  res.status: eq 403
}

tests {
  test("Расчёт доступен только наблюдателю", function () {
    expect(res.getBody().detail).to.equal("Недостаточно прав для выполнения операции");
  });
}

docs {
  Готовый маршрут для назначенного исполнителя появится отдельной ручкой чтения,
  когда сервис начнёт сохранять планы маршрутов.
}
