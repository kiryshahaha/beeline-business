meta {
  name: Наблюдатель строит маршрут
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/routes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{observer_access_token}}
}

body:json {
  {
    "origin": {"latitude": 59.9156, "longitude": 30.4631},
    "destination": {"latitude": 59.9015, "longitude": 30.4548}
  }
}

tests {
  test("Наблюдатель получает маршрут при настроенном Geoapify", function () {
    const status = res.getStatus();
    const body = res.getBody();

    if (status === 503) {
      expect(body.detail).to.equal("Сервис построения маршрутов не настроен");
      return;
    }

    expect(status).to.equal(200);
    expect(body.distance_meters).to.be.a("number").and.greaterThan(0);
    expect(body.duration_seconds).to.be.a("number").and.greaterThan(0);
    expect(body.geometry.type).to.equal("MultiLineString");
    expect(body.geometry.coordinates).to.be.an("array").and.not.empty;
  });
}

docs {
  Координаты запроса указываются как latitude/longitude. Координаты в GeoJSON-линии
  возвращаются как longitude/latitude. При наличии GEOAPIFY_API_KEY запрос делает
  реальный платный вызов Geoapify; без ключа проверяется ответ 503 о настройке сервиса.
}
