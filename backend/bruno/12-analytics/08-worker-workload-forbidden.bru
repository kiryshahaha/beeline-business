meta {
  name: Исполнитель не получает загруженность бригад
  type: http
  seq: 8
}

get {
  url: {{base_url}}/api/v1/analytics/brigades-workload
  body: none
  auth: bearer
}

auth:bearer {
  token: {{worker_access_token}}
}

assert {
  res.status: eq 403
}

tests {
  test("Доступ к загруженности закрыт для исполнителя", function () {
    expect(res.getBody().detail).to.equal("Недостаточно прав для выполнения операции");
  });
}
