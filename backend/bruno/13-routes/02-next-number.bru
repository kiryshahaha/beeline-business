meta {
  name: next-number
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/routes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{observer_access_token}}
}

body:json {
  {"worker_id": {{worker_id}}, "route_date": "2026-09-21", "stops": [{"location_id": {{location_id}}, "arrival_at": "2026-09-21T09:00:00+03:00"}, {"location_id": {{location_id}}, "arrival_at": "2026-09-21T10:00:00+03:00"}]}
}

assert {
  res.status: eq 201
}

tests {
test("Номер растёт в пределах дня и инженера", () => { expect(res.getBody().route_number).to.equal(bru.getVar("first_route_number") + 1); });
}
