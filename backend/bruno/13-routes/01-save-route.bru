meta {
  name: save-route
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/routes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{observer_access_token}}
}

body:json {
  {"worker_id": {{worker_id}}, "route_date": "2026-09-21", "stops": [{"location_id": {{location_id}}, "arrival_at": "2026-09-21T09:00:00+03:00"}, {"location_id": {{location_id}}, "arrival_at": "2026-09-21T10:00:00+03:00"}]}
}

script:post-response {
if (res.getStatus() === 201) { bru.setVar("saved_route_id", res.getBody().id); bru.setVar("first_route_number", res.getBody().route_number); }
}

assert {
  res.status: eq 201
}

tests {
test("GeoJSON хранит порядок и прибытие", () => { const r = res.getBody(); expect(r.geojson.type).to.equal("FeatureCollection"); expect(r.route_number).to.equal(1); expect(r.geojson.features[0].properties.sequence).to.equal(1); expect(r.geojson.features[1].properties.arrival_at).to.equal("2026-09-21T10:00:00+03:00"); });
}
