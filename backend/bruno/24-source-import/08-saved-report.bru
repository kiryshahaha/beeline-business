meta {
  name: Сохранённый отчёт импорта
  type: http
  seq: 8
}

get {
  url: {{base_url}}/api/v1/data/sources/imports/{{source_import_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{observer_access_token}}
}

assert {
  res.status: eq 200
  res.body.dataset: eq Bruno
  res.body.mapping_version: eq 1
}
