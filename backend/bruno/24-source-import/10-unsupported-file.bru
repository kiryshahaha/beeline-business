meta {
  name: Неподдерживаемый файл — 422
  type: http
  seq: 10
}

post {
  url: {{base_url}}/api/v1/data/sources/import
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{observer_access_token}}
}

body:multipart-form {
  file: @file(fixtures/manifest.json)
}

assert {
  res.status: eq 422
  res.body.detail.code: eq source_format
}
