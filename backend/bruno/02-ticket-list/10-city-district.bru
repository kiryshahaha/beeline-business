meta {
  name: Город и район
  type: http
  seq: 10
}

get {
  url: {{base_url}}/api/v1/tickets?city_id={{city_id}}&service_area_id={{service_area_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{observer_access_token}}
}

params:query {
  city_id: {{city_id}}
  service_area_id: {{service_area_id}}
}

assert {
  res.status: eq 200
}

tests {
  test("Каждая заявка соответствует заданным фильтрам", function () {
    res.getBody().forEach(function (ticket) {
      expect(ticket.location.city_id).to.equal(Number(bru.getVar("city_id")));
      expect(ticket.location.service_area_id).to.equal(Number(bru.getVar("service_area_id")));
    });
  });

  test("Размер страницы не превышает лимит", function () {
    expect(res.getBody().length).to.be.at.most(20);
  });
}

docs {
  Оба условия действуют одновременно (AND). Район другого города даст пустой массив.
}
