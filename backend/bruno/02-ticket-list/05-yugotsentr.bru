meta {
  name: Участок «Югоцентр»
  type: http
  seq: 5
}

get {
  url: {{base_url}}/api/v1/tickets?service_area_id={{yugotsentr_service_area_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{observer_access_token}}
}

params:query {
  service_area_id: {{yugotsentr_service_area_id}}
}

assert {
  res.status: eq 200
}

tests {
  test("Каждая заявка соответствует заданным фильтрам", function () {
    res.getBody().forEach(function (ticket) {
      expect(ticket.location.service_area_id).to.equal(Number(bru.getVar("yugotsentr_service_area_id")));
    });
  });

  test("Размер страницы не превышает лимит", function () {
    expect(res.getBody().length).to.be.at.most(20);
  });
}

docs {
  Третий участок демобазы — «Югоцентр». Проверьте ID по location.service_area_id в ответе списка.
}
