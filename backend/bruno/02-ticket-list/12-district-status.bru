meta {
  name: Район и статус
  type: http
  seq: 12
}

get {
  url: {{base_url}}/api/v1/tickets?district_id={{district_id}}&status=planned
  body: none
  auth: bearer
}

auth:bearer {
  token: {{observer_access_token}}
}

params:query {
  district_id: {{district_id}}
  status: planned
}

assert {
  res.status: eq 200
}

tests {
  test("Каждая заявка соответствует заданным фильтрам", function () {
    res.getBody().forEach(function (ticket) {
      expect(ticket.location.district_id).to.equal(Number(bru.getVar("district_id")));
      expect(ticket.status).to.equal("planned");
    });
  });

  test("Размер страницы не превышает лимит", function () {
    expect(res.getBody().length).to.be.at.most(20);
  });
}

docs {
  Запланированные заявки выбранного района.
}
