meta {
  name: Не будет исправлено
  type: http
  seq: 9
}

get {
  url: {{base_url}}/api/v1/tickets?status=wont_fix
  body: none
  auth: bearer
}

auth:bearer {
  token: {{observer_access_token}}
}

params:query {
  status: wont_fix
}

assert {
  res.status: eq 200
}

tests {
  test("Каждая заявка соответствует заданным фильтрам", function () {
    res.getBody().forEach(function (ticket) {
      expect(ticket.status).to.equal("wont_fix");
    });
  });

  test("Размер страницы не превышает лимит", function () {
    expect(res.getBody().length).to.be.at.most(20);
  });
}

docs {
  Если заявок с этим статусом пока нет, ожидается 200 и [].
}
