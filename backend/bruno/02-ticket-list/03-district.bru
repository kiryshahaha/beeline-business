meta {
  name: По выбранному району
  type: http
  seq: 3
}

get {
  url: {{base_url}}/api/v1/tickets?service_area_id={{service_area_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{observer_access_token}}
}

params:query {
  service_area_id: {{service_area_id}}
}

assert {
  res.status: eq 200
}

tests {
  test("Каждая заявка соответствует заданным фильтрам", function () {
    res.getBody().forEach(function (ticket) {
      expect(ticket.location.service_area_id).to.equal(Number(bru.getVar("service_area_id")));
    });
  });

  test("Размер страницы не превышает лимит", function () {
    expect(res.getBody().length).to.be.at.most(20);
  });
}

docs {
  Район можно указать без города. Local.service_area_id — выбранный район, по умолчанию Невский в новой демобазе.
}
