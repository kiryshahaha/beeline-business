meta {
  name: Следующая страница района
  type: http
  seq: 15
}

get {
  url: {{base_url}}/api/v1/tickets?district_id={{district_id}}&limit=2&offset=2
  body: none
  auth: none
}

params:query {
  district_id: {{district_id}}
  limit: 2
  offset: 2
}

assert {
  res.status: eq 200
}

tests {
  test("Каждая заявка соответствует заданным фильтрам", function () {
    res.getBody().forEach(function (ticket) {
      expect(ticket.location.district_id).to.equal(Number(bru.getVar("district_id")));
    });
  });

  test("Размер страницы не превышает лимит", function () {
    expect(res.getBody().length).to.be.at.most(2);
  });
}

docs {
  Пропустить первые две подходящие заявки и получить следующие две.
}
