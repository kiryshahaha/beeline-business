meta {
  name: Архивная учётная запись не входит
  type: http
  seq: 8
}

post {
  url: {{base_url}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "history_bruno_worker",
    "password": "HistoryWorker123!"
  }
}

assert {
  res.status: eq 403
}

tests {
  test("Понятная причина отказа", function () {
    expect(res.getBody().detail).to.equal("Учётная запись в архиве");
  });
}
