meta {
  name: Новый исполнитель без истории
  type: http
  seq: 6
}

post {
  url: {{base_url}}/api/v1/users
  body: json
  auth: bearer
}

auth:bearer {
  token: {{observer_access_token}}
}

body:json {
  {
    "name": "Архив",
    "surname": "Проверочный",
    "username": "history_bruno_worker",
    "password": "HistoryWorker123!",
    "role": "worker",
    "worker_profile": {
      "workshift_start": "09:00:00",
      "workshift_end": "18:00:00",
      "skills": ["Монтаж ВОЛС"]
    }
  }
}

script:post-response {
  if (res.getStatus() === 201) bru.setVar("history_temp_id", res.getBody().id);
}

assert {
  res.status: eq 201
  res.body.archived_at: isNull
}
