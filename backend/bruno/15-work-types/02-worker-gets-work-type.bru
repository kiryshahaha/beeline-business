meta {
  name: Исполнитель читает вид работ по ID
  type: http
  seq: 2
}

get {
  url: {{base_url}}/api/v1/work-types/{{work_type_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{worker_access_token}}
}

assert {
  res.status: eq 200
  res.body.id: eq {{work_type_id}}
  res.body.norm_minutes: isNumber
}
