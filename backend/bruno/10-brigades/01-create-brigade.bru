meta {
  name: Создать бригаду
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/brigades
  body: json
  auth: bearer
}

auth:bearer {
  token: {{observer_access_token}}
}

body:json {
  {
    "name": "Новая Тестовая Бригада",
    "foreman_id": 3,
    "office_id": 1,
    "worker_ids": []
  }
}

assert {
  res.status: eq 201
  res.body.id: isNumber
  res.body.name: eq "Новая Тестовая Бригада"
  res.body.office_id: eq 1
}
