meta {
  name: Обновить состав бригады
  type: http
  seq: 4
}

put {
  url: {{base_url}}/api/v1/brigades/{{workflow_brigade_id}}/members
  body: json
  auth: bearer
}

auth:bearer {
  token: {{observer_access_token}}
}

body:json {
  {
    "foreman_id": {{workflow_foreman_id}},
    "office_id": {{workflow_office_id}},
    "worker_ids": []
  }
}

assert {
  res.status: eq 200
  res.body.id: eq {{workflow_brigade_id}}
}
