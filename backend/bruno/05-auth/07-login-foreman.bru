meta {
  name: Войти как бригадир
  type: http
  seq: 7
}

post {
  url: {{base_url}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {"username":"{{foreman_username}}","password":"{{foreman_password}}"}
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("foreman_access_token", res.getBody().access_token);
  }
}

assert {
  res.status: eq 200
}

tests {
  test("Получен access-токен бригадира", function () {
    expect(res.getBody().access_token).to.be.a("string").and.not.empty;
  });
}
