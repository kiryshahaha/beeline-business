meta {
  name: Войти как наблюдатель
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {"username":"{{observer_username}}","password":"{{observer_password}}"}
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("observer_access_token", res.getBody().access_token);
  }
}

assert {
  res.status: eq 200
}

tests {
  test("Получен access-токен наблюдателя", function () {
    expect(res.getBody().access_token).to.be.a("string").and.not.empty;
  });
}
