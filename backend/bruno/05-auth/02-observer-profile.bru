meta {
  name: Профиль наблюдателя
  type: http
  seq: 2
}

get {
  url: {{base_url}}/api/v1/users/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{observer_access_token}}
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("observer_id", res.getBody().id);
  }
}

assert {
  res.status: eq 200
}

tests {
  test("Профиль имеет роль observer", function () {
    expect(res.getBody().role).to.equal("observer");
  });
}
