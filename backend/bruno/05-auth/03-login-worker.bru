meta {
  name: Войти как исполнитель
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {"username":"{{worker_username}}","password":"{{worker_password}}"}
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("worker_access_token", res.getBody().access_token);
  }
}

assert {
  res.status: eq 200
}
