meta {
  name: transport-persists
  type: http
  seq: 5
}

get {
  url: {{base_url}}/api/v1/users/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{worker_access_token}}
}

assert {
  res.status: eq 200
}

tests {
test("Профиль работника содержит транспорт", () => { expect(res.getBody().worker_profile.transport_type).to.equal("public_transport"); });
}
