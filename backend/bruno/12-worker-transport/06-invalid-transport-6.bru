meta {
  name: invalid-transport-6
  type: http
  seq: 6
}

patch {
  url: {{base_url}}/api/v1/users/{{worker_id}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{observer_access_token}}
}

body:json {
  {
    "worker_profile": {
      "transport_type": "helicopter"
    }
  }
}

assert {
  res.status: eq 422
}
