meta {
  name: Второй расчёт того же набора
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/v1/planning/preview
  body: json
  auth: bearer
}

auth:bearer {
  token: {{observer_access_token}}
}

body:json {
  {"route_date":"2030-01-15","ticket_ids":{{planning_ticket_ids}},"worker_ids":{{planning_worker_ids}},"allow_partial":false}
}

assert {
  res.status: eq 201
}

script:post-response {
  if (res.getStatus() === 201) bru.setVar("planning_stale_id", res.getBody().plan_id);
}
