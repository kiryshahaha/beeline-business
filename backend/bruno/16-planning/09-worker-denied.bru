meta {
  name: Исполнитель не планирует чужие заявки
  type: http
  seq: 10
}

post {
  url: {{base_url}}/api/v1/planning/preview
  body: json
  auth: bearer
}

auth:bearer {
  token: {{worker_access_token}}
}

body:json {
  {"route_date":"2030-01-15","ticket_ids":{{planning_ticket_ids}},"worker_ids":{{planning_worker_ids}},"allow_partial":false}
}

assert {
  res.status: eq 403
}
