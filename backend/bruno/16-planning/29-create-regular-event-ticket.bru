meta {
  name: Создать обычную заявку для T4
  type: http
  seq: 29
}

post {
  url: {{base_url}}/api/v1/tickets
  body: json
  auth: bearer
}

auth:bearer {
  token: {{observer_access_token}}
}

body:json {
  {
    "location_id": {{planning_location_id}},
    "service_area_id": {{planning_service_area_id}},
    "title": "T4 обычная заявка",
    "description": "Сценарий безопасной вставки новой заявки",
    "work_type_id": {{planning_work_type_id}},
    "category": "repair",
    "priority": 3,
    "received_at": "2030-01-15T07:00:00+03:00",
    "visit_window_start": "2030-01-15T07:00:00+03:00",
    "visit_window_end": "2030-01-15T18:00:00+03:00",
    "estimated_duration_minutes": 5
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("planning_event_regular_ticket_id", res.getBody().id);
  }
}

tests {
  test("Событие новой заявки получило серверную категорию repair", () => {
    expect(res.getBody().category).to.equal("repair");
    expect(res.getBody().last_event_id).to.be.a("number");
  });
}
