meta {
  name: Отказ на границе количества заявок
  type: http
  seq: 22
}

post {
  url: {{base_url}}/api/v1/planning/preview
  body: json
  auth: bearer
}

auth:bearer {
  token: {{observer_access_token}}
}

body:json {
  {"route_date":"2030-01-15","ticket_ids":{{planning_over_limit_ticket_ids}},"worker_ids":{{planning_worker_ids}},"allow_partial":false}
}

assert {
  res.status: eq 422
}

tests {
  test("51 IDs fail at the documented request boundary", () => {
    const error = res.getBody().detail[0];
    expect(error.loc).to.deep.equal(["body", "ticket_ids"]);
    expect(error.ctx.max_length).to.equal(50);
  });
}

docs {
  Запрос содержит 51 уникальный положительный ID; API отклоняет его по пределу
  в 50 элементов схемы до чтения тикетов и обращения к Geoapify или planner.
}
