meta {
  name: Неизвестная заявка отклоняется
  type: http
  seq: 11
}

post {
  url: {{base_url}}/api/v1/planning/preview
  body: json
  auth: bearer
}

auth:bearer {
  token: {{observer_access_token}}
}

body:json {
  {"route_date":"2030-01-15","ticket_ids":[2147483647],"worker_ids":{{planning_worker_ids}}}
}

assert {
  res.status: eq 422
}

tests {
  test("Точный код ошибки", () => expect(res.getBody().detail.code).to.equal("unknown_ids"));
}
