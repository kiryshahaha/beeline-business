meta {
  name: Проверить, что эксперимент не опубликовал ревизию
  type: http
  seq: 28
}

get {
  url: {{base_url}}/api/v1/planning/areas/{{planning_service_area_id}}/2030-01-15/current
  auth: bearer
}

auth:bearer {
  token: {{observer_access_token}}
}

assert {
  res.status: eq 200
}

tests {
  test("После сравнения текущая ревизия плана не изменилась", () => {
    expect(res.getBody().revision).to.equal(Number(bru.getVar("planning_day_revision")));
  });
}
