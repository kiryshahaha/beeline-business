meta {
  name: Повтор применения не создаёт дубли
  type: http
  seq: 6
}

post {
  url: {{base_url}}/api/v1/planning/plans/{{planning_plan_id}}/apply

  auth: bearer
}

auth:bearer {
  token: {{observer_access_token}}
}

assert {
  res.status: eq 200
}

tests {
  test("Сохранена первоначальная квитанция", () => {
    expect(res.getBody().already_applied).to.equal(true);
    expect(JSON.stringify(res.getBody().routes.map(r => r.id))).to.equal(bru.getVar("planning_saved_ids"));
  });
}
