meta {
  name: Предварительный план без назначений
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/planning/preview
  body: json
  auth: bearer
}

auth:bearer {
  token: {{observer_access_token}}
}

body:json {
  {"route_date":"2030-01-15","ticket_ids":{{planning_ticket_ids}},"worker_ids":{{planning_worker_ids}},"allow_partial":false}
}

assert {
  res.status: eq 201
}

script:post-response {
  if (res.getStatus() === 201) bru.setVar("planning_plan_id", res.getBody().plan_id);
}

tests {
  test("Все заявки помещаются в смены", () => {
    const b = res.getBody();
    expect(res.getStatus(), JSON.stringify(b)).to.equal(201);
    expect(b.state).to.equal("ready");
    expect(JSON.stringify(b.planning_policy)).to.equal(bru.getVar("planning_execution_policy"));
    bru.setVar("planning_recorded_policy", JSON.stringify(b.planning_policy));
    expect(b.unassigned).to.have.lengthOf(0);
    expect(b.outcome).to.equal("complete");
    expect(b.metrics.assigned_tickets).to.equal(24);
    expect(b.metrics.used_workers).to.equal(b.routes.length);
    expect(b.resource_estimate).to.equal(null);
    expect(b.routes.flatMap(r => r.stops)).to.have.lengthOf(24);
    for (const s of b.routes.flatMap(r => r.stops)) {
      expect(s.factors.map(f => f.code)).to.include.members(["skills_match", "transport", "start_in_window", "equal_priority"]);
      for (const f of s.factors) expect(f.message).to.be.a("string").and.not.equal("");
    }
    expect(new Set(b.routes.map(r => r.transport_type)).size).to.equal(4);
    for (const r of b.routes) {
      expect(r.geometry.type).to.equal("MultiLineString");
      expect(r.route_number).to.equal(undefined);
      for (const s of r.stops) expect(Date.parse(s.service_end_at) - Date.parse(s.arrival_at)).to.equal(20*60000);
    }
  });
}
