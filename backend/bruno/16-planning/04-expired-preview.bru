meta {
  name: Истёкший preview нельзя применить
  type: http
  seq: 4
}

post {
  url: {{base_url}}/api/v1/planning/preview
  body: json
  auth: bearer
}

auth:bearer {
  token: {{observer_access_token}}
}

body:json {
  {"route_date":"2030-01-15","ticket_ids":{{planning_ticket_ids}},"worker_ids":{{planning_worker_ids}},"allow_partial":false}
}

assert {
  res.status: eq 201
}

script:post-response {
  if (res.getStatus() === 201) bru.setVar("planning_expired_id", res.getBody().plan_id);
}

tests {
  test("Третий preview ждёт отдельной проверки срока", () => {
    expect(res.getBody().state).to.equal("ready");
    expect(res.getBody().unassigned).to.have.lengthOf(0);
  });
}
