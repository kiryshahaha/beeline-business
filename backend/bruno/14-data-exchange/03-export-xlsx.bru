meta {
  name: export-xlsx
  type: http
  seq: 3
}

get {
  url: {{base_url}}/api/v1/data/export?format=xlsx
  body: none
  auth: bearer
}

auth:bearer {
  token: {{observer_access_token}}
}

assert {
  res.status: eq 200
}

tests {
test("XLSX выгружается целиком", () => { expect(res.getHeader("content-type")).to.include("spreadsheetml.sheet"); });
}
