meta {
  name: all-domain-tables
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/v1/data/schema
  body: none
  auth: bearer
}

auth:bearer {
  token: {{observer_access_token}}
}

assert {
  res.status: eq 200
}

tests {
  test("Полная схема без секретов", () => {
    const schema = res.getBody();
    const tables = Object.keys(schema.tables);
    expect(tables).to.have.lengthOf(29);
    expect(tables).to.include.members([
      "divisions",
      "equipment_movements",
      "work_events",
      "worker_day_states",
      "day_plan_revisions",
    ]);
    expect(schema.tables.routes).to.be.an("array");
    expect(schema.tables.users.map((column) => column.name)).not.to.include("password_hash");
  });
}
