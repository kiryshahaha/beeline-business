meta {
  name: export-csv
  type: http
  seq: 2
}

get {
  url: {{base_url}}/api/v1/data/export?format=csv
  body: none
  auth: bearer
}

auth:bearer {
  token: {{observer_access_token}}
}

assert {
  res.status: eq 200
}

tests {
test("CSV выгружается архивом", () => { expect(res.getHeader("content-type")).to.include("application/zip"); expect(res.getHeader("cache-control")).to.equal("no-store"); });
}
