meta {
  name: Бригадир получает сводку своей бригады
  type: http
  seq: 3
}

get {
  url: {{base_url}}/api/v1/analytics/tickets-summary?period=month&office_id={{office_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{foreman_access_token}}
}

assert {
  res.status: eq 200
}

tests {
  test("Сводка бригадира ограничена его бригадой", function () {
    const body = res.getBody();
    ["open", "assigned", "in_progress", "completed"].forEach(function (field) {
      expect(body[field]).to.be.a("number").and.at.least(0);
    });
  });
}

docs {
  Для foreman сервер игнорирует office_id и находит brigade_id по текущему пользователю.
}
