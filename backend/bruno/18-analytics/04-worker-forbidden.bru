meta {
  name: Исполнитель не получает сводку
  type: http
  seq: 4
}

get {
  url: {{base_url}}/api/v1/analytics/tickets-summary?period=month
  body: none
  auth: bearer
}

auth:bearer {
  token: {{worker_access_token}}
}

assert {
  res.status: eq 403
}

tests {
  test("Доступ к аналитике закрыт для исполнителя", function () {
    expect(res.getBody().detail).to.equal("Недостаточно прав для выполнения операции");
  });
}
