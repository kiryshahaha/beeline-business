meta {
  name: Наблюдатель получает сводку заявок
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/v1/analytics/tickets-summary?period=month
  body: none
  auth: bearer
}

auth:bearer {
  token: {{observer_access_token}}
}

assert {
  res.status: eq 200
}

tests {
  test("Сводка содержит четыре числовых счётчика", function () {
    const body = res.getBody();
    ["open", "assigned", "in_progress", "completed"].forEach(function (field) {
      expect(body[field]).to.be.a("number").and.at.least(0);
    });
  });

  test("Текущая очередь, период и план — разные величины", function () {
    const body = res.getBody();
    [
      "open_unassigned",
      "open_assigned",
      "created_in_period",
      "completed_in_period",
      "planned_for_date"
    ].forEach(function (field) {
      expect(body[field]).to.be.a("number").and.at.least(0);
    });
    expect(body.open).to.equal(body.open_unassigned);
    expect(body.completed).to.equal(body.completed_in_period);
    expect(body.period_start).to.match(/T00:00:00\+03:00$/);
    expect(new Date(body.period_end) > new Date(body.period_start)).to.equal(true);
  });
}

docs {
  Период month — текущий календарный месяц по Москве, полуинтервал [начало, конец).
  open и in_progress — текущее состояние и от периода не зависят; completed_in_period
  считается по фактическому времени завершения, а не по updated_at.
}
