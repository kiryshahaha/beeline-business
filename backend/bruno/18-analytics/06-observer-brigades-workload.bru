meta {
  name: Наблюдатель получает загруженность бригад
  type: http
  seq: 6
}

get {
  url: {{base_url}}/api/v1/analytics/brigades-workload
  body: none
  auth: bearer
}

auth:bearer {
  token: {{observer_access_token}}
}

assert {
  res.status: eq 200
}

tests {
  test("Ответ содержит загруженность каждой бригады", function () {
    const body = res.getBody();
    expect(body).to.be.an("array");
    body.forEach(function (brigade) {
      expect(brigade.brigade_name).to.be.a("string").and.not.empty;
      expect(brigade.active_tickets).to.be.a("number").and.at.least(0);
      expect(brigade.completed_today).to.be.a("number").and.at.least(0);
    });
  });
}

docs {
  active_tickets включает заявки со статусами planned и in_progress.
  completed_today считает заявки completed, обновлённые сегодня.
}
