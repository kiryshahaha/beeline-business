meta {
  name: Наблюдатель получает загруженность бригад
  type: http
  seq: 6
}

get {
  url: {{base_url}}/api/v1/analytics/brigades-workload
  body: none
  auth: bearer
}

auth:bearer {
  token: {{observer_access_token}}
}

assert {
  res.status: eq 200
}

tests {
  test("Ответ содержит загруженность каждой бригады", function () {
    const body = res.getBody();
    expect(body).to.be.an("array");
    body.forEach(function (brigade) {
      expect(brigade.brigade_name).to.be.a("string").and.not.empty;
      expect(brigade.active_tickets).to.be.a("number").and.at.least(0);
      expect(brigade.completed_today).to.be.a("number").and.at.least(0);
      [
        "shift_minutes",
        "service_minutes",
        "travel_minutes",
        "waiting_minutes",
        "free_minutes",
        "overtime_minutes"
      ].forEach(function (field) {
        expect(brigade[field]).to.be.a("number").and.at.least(0);
      });
      expect(brigade.available_workers).to.be.at.most(brigade.workers);
    });
  });
}

docs {
  Загрузка считается по сменам даты (по умолчанию сегодня по Москве): работа, дорога
  и ожидание из сохранённых маршрутов, свободное время смены. Отмеченный недоступным на
  эту дату исполнитель ёмкости не даёт. completed_today — по фактическому времени
  завершения, а не по updated_at.
}
