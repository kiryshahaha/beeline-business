meta {
  name: Повтор выдачи с тем же ключом
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/v1/workers/{{equipment_worker_id}}/equipment/issue
  body: json
  auth: bearer
}

auth:bearer {
  token: {{observer_access_token}}
}

body:json {
  {"operation_key":"bruno-kit-2030-01-15","date":"2030-01-15"}
}

assert {
  res.status: eq 200
  res.body.already_applied: eq true
}

tests {
  test("Возвращается прежняя квитанция без новой выдачи", () => {
    expect(res.getBody().id).to.equal(Number(bru.getVar("equipment_issue_id")));
  });
}
