# Local example only. Set credentials for your own PostgreSQL database.
DATABASE_URL=postgresql+psycopg://beeline:beeline@localhost:5432/beeline

# Notification outbox polling. Disable only in tests or a dedicated worker process.
NOTIFICATION_DISPATCHER_ENABLED=true
NOTIFICATION_POLL_INTERVAL_SECONDS=1.0

# Firebase uses Application Default Credentials. Keep the JSON file outside Git.
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json

# Calendar feed links. Empty PUBLIC_API_URL uses the request host; empty FRONTEND_URL
# omits the ticket card link from calendar events.
PUBLIC_API_URL=
FRONTEND_URL=http://localhost:3000

# Geoapify Routing and Route Matrix. Restrict this server-side key by IP in Geoapify.
GEOAPIFY_API_KEY=
GEOAPIFY_TIMEOUT_SECONDS=10

# Planning is enabled explicitly after configuring work requirements and secrets.
PLANNING_ENABLED=false
PLANNER_SERVICE_TOKEN=
PLANNER_BASE_URL=http://127.0.0.1:8001
PLANNING_SOLVE_TIME_LIMIT_SECONDS=5
PLANNING_PREVIEW_TTL_SECONDS=300
PLANNING_TOTAL_TIMEOUT_SECONDS=60
